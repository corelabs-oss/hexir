module attributes {hexir.targets = ["cpu", "cuda"]} {
  func.func @main() {
    %cst = arith.constant dense<[[3.000000e+00, 1.000000e+00], [2.000000e+00, 2.000000e+00]]> : tensor<2x2xf64>
    %cst_0 = arith.constant dense<[[1.000000e+00, 5.000000e+00], [5.000000e+00, 2.000000e+00]]> : tensor<2x2xf64>
    %0 = ls_gpu.matmul %cst, %cst_0 : tensor<2x2xf64>
    %1 = ls_cpu.relu %0 : tensor<2x2xf64>
    %2 = bufferization.to_buffer %1 read_only : tensor<2x2xf64> to memref<2x2xf64>
    hexir.print %2 {device = "cpu"} : memref<2x2xf64>
    return
  }
}
